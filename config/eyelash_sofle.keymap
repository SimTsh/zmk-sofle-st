#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// ============================================================
// IntelliJ Layer — Keycode Aliases (used in hold-tap pairs)
// ============================================================

// Panels
#define IJ_TERM_KC        LA(F12)          // Alt+F12        — Terminal
#define IJ_RUN_PNL_KC     LA(N4)           // Alt+4          — Run Panel
#define IJ_PROJ_KC        LA(N1)           // Alt+1          — Project Panel
#define IJ_COMMIT_KC      LA(N0)           // Alt+0          — Commit Panel
#define IJ_CALL_HIER_KC   LC(LA(H))        // Ctrl+Alt+H     — Call Hierarchy
#define IJ_CLS_HIER_KC    LC(H)            // Ctrl+H         — Class Hierarchy
#define IJ_DEBUG_PNL_KC   LA(N5)           // Alt+5          — Debug Panel
#define IJ_EVAL_KC        LA(F8)           // Alt+F8         — Evaluate Expression

// Navigation
#define IJ_DECL_KC        LC(B)            // Ctrl+B         — Go to Declaration
#define IJ_IMPL_KC        LC(LA(B))        // Ctrl+Alt+B     — Go to Implementation
#define IJ_BLK_START_KC   LC(LBKT)         // Ctrl+[         — Block Start
#define IJ_RM_OCC_KC      LA(LS(J))        // Alt+Shift+J    — Remove Occurrence
#define IJ_USAGES_KC      LC(LA(F7))       // Ctrl+Alt+F7    — Show Usages
#define IJ_FILE_STRUCT_KC LC(F12)          // Ctrl+F12       — File Structure
#define IJ_LAST_EDIT_KC   LC(LS(BSPC))     // Ctrl+Shift+Bsp — Last Edit Location
#define IJ_RECENT_KC      LC(E)            // Ctrl+E         — Recent Files
#define IJ_NAV_BACK_KC    LA(LEFT)         // Alt+Left       — Navigate Back
#define IJ_SHRINK_KC      LC(LS(W))        // Ctrl+Shift+W   — Shrink Selection
#define IJ_BLK_END_KC     LC(RBKT)         // Ctrl+]         — Block End
#define IJ_ADD_OCC_KC     LA(J)            // Alt+J          — Add Next Occurrence
#define IJ_NAV_FWD_KC     LA(RIGHT)        // Alt+Right      — Navigate Forward
#define IJ_EXPAND_KC      LC(W)            // Ctrl+W         — Expand Selection

// Code Actions
#define IJ_FIX_KC         LA(ENTER)        // Alt+Enter      — Intention Actions
#define IJ_PARAM_KC       LC(P)            // Ctrl+P         — Parameter Info
#define IJ_QDEF_KC        LC(LS(I))        // Ctrl+Shift+I   — Quick Definition
#define IJ_DOC_KC         LC(Q)            // Ctrl+Q         — Quick Documentation
#define IJ_COMMENT_KC     LC(FSLH)         // Ctrl+/         — Comment
#define IJ_BLK_CMT_KC     LC(LS(FSLH))    // Ctrl+Shift+/   — Block Comment
#define IJ_NEXT_ERR_KC    F2               // F2             — Next Error
#define IJ_PREV_ERR_KC    LS(F2)           // Shift+F2       — Previous Error

// Run / Debug
#define IJ_RUN_KC         LA(LS(F10))      // Alt+Shift+F10  — Run Config
#define IJ_RUN_CUR_KC     LC(LS(F10))      // Ctrl+Shift+F10 — Run Current
#define IJ_MV_UP_KC       LS(LA(UP))       // Shift+Alt+Up   — Move Line Up
#define IJ_JOIN_KC        LC(LS(J))        // Ctrl+Shift+J   — Join Lines
#define IJ_GOTO_TEST_KC   LC(LS(T))        // Ctrl+Shift+T   — Go to Test
#define IJ_SUPER_KC       LC(U)            // Ctrl+U         — Go to Super
#define IJ_MV_DN_KC       LS(LA(DOWN))     // Shift+Alt+Down — Move Line Down
#define IJ_DUPE_KC        LC(D)            // Ctrl+D         — Duplicate Line
#define IJ_STEP_OVER_KC   F8               // F8             — Step Over
#define IJ_STEP_IN_KC     F7               // F7             — Step Into

// ============================================================

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    home_bksp: home_bksp {
        compatible = "zmk,behavior-mod-morph";
        label = "HOME_BKSP";
        bindings = <&kp HOME>, <&kp BACKSPACE>;

        #binding-cells = <0>;
        keep-mods = <(MOD_LCTL|MOD_RCTL)>;
        mods = <(MOD_LCTL|MOD_RCTL)>;
    };

    end_del: end_del {
        compatible = "zmk,behavior-mod-morph";
        label = "END_DEL";
        bindings = <&kp END>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_LCTL|MOD_RCTL)>;
        keep-mods = <(MOD_LCTL|MOD_RCTL)>;
    };

    behaviors {
        ij_ht: ij_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "IJ_HT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        // ── Panels ──────────────────────────────────────────────────────────
        ij_hide: ij_hide {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(ESCAPE)>;
            label = "IJ_HIDE"; // Shift+Esc — Hide Active Panel
        };
        ij_find: ij_find {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(N3)>;
            label = "IJ_FIND"; // Alt+3 — Find Panel
        };
        ij_git: ij_git {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(N9)>;
            label = "IJ_GIT"; // Alt+9 — Git Panel
        };
        ij_services: ij_services {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(N8)>;
            label = "IJ_SERVICES"; // Alt+8 — Services Panel
        };
        ij_problems: ij_problems {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(N6)>;
            label = "IJ_PROBLEMS"; // Alt+6 — Problems Panel
        };
        ij_switcher: ij_switcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(TAB)>;
            label = "IJ_SWITCHER"; // Ctrl+Tab — Switcher
        };
        ij_claude: ij_claude {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(K))>;
            label = "IJ_CLAUDE"; // Ctrl+Alt+K — Send to Claude Code
        };

        // ── Code Actions ────────────────────────────────────────────────────
        ij_toggle_case: ij_toggle_case {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(U))>;
            label = "IJ_TOGGLE_CASE"; // Ctrl+Shift+U — Toggle Case
        };
        ij_override: ij_override {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(O)>;
            label = "IJ_OVERRIDE"; // Ctrl+O — Override Methods
        };
        ij_generate: ij_generate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(INSERT)>;
            label = "IJ_GENERATE"; // Alt+Insert — Generate
        };
        ij_refactor: ij_refactor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(LS(T)))>;
            label = "IJ_REFACTOR"; // Ctrl+Alt+Shift+T — Refactor This
        };
        ij_surround: ij_surround {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(T))>;
            label = "IJ_SURROUND"; // Ctrl+Alt+T — Surround With
        };
        ij_paste_hist: ij_paste_hist {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(V))>;
            label = "IJ_PASTE_HIST"; // Ctrl+Shift+V — Paste from History
        };
        ij_del_line: ij_del_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(X)>;
            label = "IJ_DEL_LINE"; // Ctrl+X — Delete Line
        };
        ij_reformat: ij_reformat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(L))>;
            label = "IJ_REFORMAT"; // Ctrl+Alt+L — Reformat Code
        };
        ij_opt_imp: ij_opt_imp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(O))>;
            label = "IJ_OPT_IMP"; // Ctrl+Alt+O — Optimize Imports
        };

        // ── Run / Debug ──────────────────────────────────────────────────────
        ij_stop: ij_stop {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(F2)>;
            label = "IJ_STOP"; // Ctrl+F2 — Stop
        };
        ij_step_out: ij_step_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(F8)>;
            label = "IJ_STEP_OUT"; // Shift+F8 — Step Out
        };
        ij_resume: ij_resume {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F9>;
            label = "IJ_RESUME"; // F9 — Resume
        };

        // ── Sequence ─────────────────────────────────────────────────────────
        ij_join: ij_join {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(UP)>, <&kp LC(LS(J))>;
            label = "IJ_JOIN"; // Shift+Up, Ctrl+Shift+J — select line above then join
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1        &kp N2        &kp N3          &kp N4  &kp N5       &kp PAGE_UP    &kp N6         &kp N7  &kp N8           &kp N9      &kp N0               &kp LEFT_BRACKET
&kp TAB     &kp Q         &kp W         &kp E           &kp R   &kp T        &kp PAGE_DOWN  &kp Y          &kp U   &kp I            &kp O       &kp P                &kp RIGHT_BRACKET
&kp CAPS    &kp A         &kp S         &kp D           &kp F   &kp G        &kp HOME       &kp H          &kp J   &kp K            &kp L       &mt COLON SEMICOLON  &mt DOUBLE_QUOTES SINGLE_QUOTE
&kp LCTRL   &kp Z         &kp X         &kp C           &kp V   &kp B        &kp END        &kp N          &kp M   &kp COMMA        &kp DOT     &kp FSLH             &kp ENTER
&kp C_MUTE  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &mo 1   &kp SPACE    &kp INSERT     &kp BACKSPACE  &mo 2   &kp RIGHT_SHIFT  &kp DELETE  &mo 4
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Alphabet";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1              &kp F2          &kp F3           &kp F4                 &kp F5                                    &mmv MOVE_UP     &kp F6        &kp F7  &kp F8  &kp F9   &kp F10    &kp F11
&trans      &mt BACKSPACE HOME  &kp UP_ARROW    &mt DELETE END   &mt LC(HOME) PAGE_UP   &mt RIGHT_PARENTHESIS LEFT_PARENTHESIS    &mmv MOVE_DOWN   &kp MINUS     &kp N7  &kp N8  &kp N9   &kp PG_UP  &kp F12
&kp INSERT  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW  &mt LC(END) PAGE_DOWN  &mt RIGHT_BRACKET LEFT_BRACKET            &mmv MOVE_LEFT   &kp PLUS      &kp N4  &kp N5  &kp N6   &kp PG_DN  &trans
&kp LCTRL   &kp LC(Z)           &kp LC(X)       &kp LC(C)        &kp LC(V)              &mt SINGLE_QUOTE DOUBLE_QUOTES            &mmv MOVE_RIGHT  &kp ASTERISK  &kp N1  &kp N2  &kp N3   &kp BSLH   &kp DEL
&mkp MB3    &trans              &trans          &trans           &trans                 &trans                                    &mkp LCLK        &kp RSHFT     &trans  &kp N0  &kp DOT  &kp EQUAL
            >;

            display-name = "Nav&Num";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&kp GRAVE  &kp MINUS     &kp AT_SIGN                     &kp POUND                   &kp DOLLAR                  &kp PERCENT                               &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp PLUS      &mt AMPS PIPE                   &mt POUND MINUS             &mt GREATER_THAN LESS_THAN  &mt RIGHT_PARENTHESIS LEFT_PARENTHESIS    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp ASTERISK  &mt SINGLE_QUOTE DOUBLE_QUOTES  &mt EXCLAMATION UNDERSCORE  &mt QUESTION EQUAL          &mt RIGHT_BRACKET LEFT_BRACKET            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp PERCENT   &mt TILDE DOLLAR                &mt BACKSLASH SLASH         &mt ASTERISK DOT            &mt RIGHT_BRACE LEFT_BRACE                &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans        &trans                          &trans                      &trans                      &mt ENTER TAB                             &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Symbols";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&ij_hide  &ij_ht IJ_RUN_PNL_KC IJ_TERM_KC  &ij_ht IJ_COMMIT_KC IJ_PROJ_KC  &ij_ht IJ_CLS_HIER_KC IJ_CALL_HIER_KC  &ij_find  &trans  &trans    &trans  &ij_git  &ij_services  &ij_problems  &ij_ht IJ_EVAL_KC IJ_DEBUG_PNL_KC  &trans
&ij_switcher  &ij_ht IJ_IMPL_KC IJ_DECL_KC  &ij_ht IJ_RM_OCC_KC IJ_BLK_START_KC  &ij_ht IJ_FILE_STRUCT_KC IJ_USAGES_KC  &ij_ht IJ_RECENT_KC IJ_LAST_EDIT_KC  &trans  &trans    &ij_ht IJ_JOIN_KC IJ_MV_UP_KC  &ij_ht IJ_SUPER_KC IJ_GOTO_TEST_KC  &ij_override  &ij_claude  &ij_step_out  &trans
&ij_toggle_case  &ij_ht IJ_SHRINK_KC IJ_NAV_BACK_KC  &ij_ht IJ_ADD_OCC_KC IJ_BLK_END_KC  &ij_ht IJ_EXPAND_KC IJ_NAV_FWD_KC  &ij_ht IJ_PARAM_KC IJ_FIX_KC  &ij_ht IJ_DOC_KC IJ_QDEF_KC  &trans    &ij_ht IJ_DUPE_KC IJ_MV_DN_KC  &ij_refactor  &ij_generate  &ij_surround  &ij_ht IJ_STEP_IN_KC IJ_STEP_OVER_KC  &trans
&trans  &ij_stop  &ij_ht IJ_RUN_CUR_KC IJ_RUN_KC  &ij_ht IJ_BLK_CMT_KC IJ_COMMENT_KC  &ij_paste_hist  &ij_ht IJ_PREV_ERR_KC IJ_NEXT_ERR_KC  &trans    &ij_del_line  &trans  &ij_reformat  &ij_opt_imp  &ij_resume  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Customs";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_4 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans          &trans        &trans          &mmv MOVE_DOWN   &trans  &trans  &kp F11     &kp F12    &kp UNDER    &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &studio_unlock  &trans        &trans          &mmv MOVE_LEFT   &trans  &trans  &trans      &trans     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader     &trans        &trans          &mmv MOVE_RIGHT  &trans  &trans  &sys_reset  &soft_off  &bootloader  &trans
&trans     &trans        &trans          &trans          &trans        &trans          &mkp LCLK        &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "Controls";
            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        CustomLayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
